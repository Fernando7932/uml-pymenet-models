@startuml

title Diagrama C4 Nivel 3: Componentes (Diagrama de Paquetes UML) - Core Backend

' === APLICANDO REGLAS DE LA SEMANA 07 (Diagrama de Paquetes) ===

package "Core Backend & API Gateway (Contenedor Python)" {

    package "API_Controllers" {
        note "Gestiona las rutas HTTP\ny la seguridad." as N1
    }

    package "Business_Services" {
        note "Contiene la lógica core:\n- Procesamiento de Pandas\n- Gestión de Workspaces" as N2
    }

    package "Data_Access" {
        note "Patrón Repositorio para\ncomunicarse con PostgreSQL." as N3
    }

    package "External_Clients" {
        note "Cliente HTTP para enviar\nprompts al AI Engine." as N4
    }
}

' Sistemas externos (para dar contexto)
database "PostgreSQL" as db
component "AI Analytics Engine" as ai
component "Web App / Mobile App" as frontends

' === RELACIONES Y DEPENDENCIAS (Líneas punteadas) ===

frontends ..> API_Controllers : Peticiones HTTPS

' Dependencias internas usando estereotipos UML (Semana 07)
API_Controllers ..> Business_Services : <<use>>
Business_Services ..> External_Clients : <<use>>
Business_Services ..> Data_Access : <<import>>

' Salidas hacia otros contenedores
External_Clients ..> ai : Envía Prompts (REST)
Data_Access ..> db : Ejecuta Consultas (SQL)

@enduml
@startuml "CUS-02: Gestionar Entornos"
left to right direction

skinparam usecase {
  BackgroundColor #FFF9C4
  BorderColor #7A1631
  StereotypeFontColor #2E7D32
}
skinparam actor {
  BackgroundColor #FFF9C4
  BorderColor #7A1631
  StereotypeFontColor #2E7D32
}
skinparam Arrow {
  Color #7A1631
}

actor "Usuario" as Cliente

rectangle "Gestión de Dashboards y Workspaces" {
  usecase "Anclar Gráfico a Dashboard" as UC1
  usecase "Validar Límite de Suscripción" as UC2
  usecase "Visualizar Tablero de Control" as UC3
  usecase "Generar Enlace Compartible" as UC4
}

Cliente -- UC1
Cliente -- UC3
Cliente -- UC4

UC1 .> UC2 : <<include>>
@enduml
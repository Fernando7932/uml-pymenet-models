@startuml "CUS-01: Consultar datos"
left to right direction

skinparam usecase {
  BackgroundColor #FFF9C4
  BorderColor #7A1631
  StereotypeFontColor #2E7D32
}
skinparam actor {
  BackgroundColor #FFF9C4
  BorderColor #7A1631
  StereotypeFontColor #2E7D32
}
skinparam Arrow {
  Color #7A1631
}

actor "Usuario" as Cliente
actor "Agente de IA (LLM)" <<Sistema Externo>> as LLM
actor "Base de Datos" <<Sistema Externo>> as BD

rectangle "Motor Analítico (Chat)" {
  usecase "Ingresar Prompt en Lenguaje Natural" as UC1
  usecase "Procesar Intención Analítica" as UC2
  usecase "Ejecutar Consulta Read-Only" as UC3
  usecase "Renderizar Resultados e Insights" as UC4
}

Cliente -- UC1
Cliente -- UC4

UC1 .> UC2 : <<include>>
UC2 .> UC3 : <<include>>
UC3 .> UC4 : <<include>>

UC2 -- LLM
UC3 -- BD
@enduml
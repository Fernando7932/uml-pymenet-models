@startuml "CUS-03: Gestionar Identidad"
left to right direction

skinparam usecase {
  BackgroundColor #FFF9C4
  BorderColor #7A1631
  StereotypeFontColor #2E7D32
}
skinparam actor {
  BackgroundColor #FFF9C4
  BorderColor #7A1631
  StereotypeFontColor #2E7D32
}
skinparam Arrow {
  Color #7A1631
}

actor "Usuario No Autenticado" as Guest
actor "Base de Datos" <<Sistema Externo>> as BD

rectangle "Autenticación & Registro (IAM)" {
  usecase "Registrar nueva cuenta" as UC1
  usecase "Iniciar Sesión" as UC2
  usecase "Validar Credenciales y Token" as UC3
}

Guest -- UC1
Guest -- UC2

UC1 .> UC3 : <<include>>
UC2 .> UC3 : <<include>>

UC3 -- BD
@enduml
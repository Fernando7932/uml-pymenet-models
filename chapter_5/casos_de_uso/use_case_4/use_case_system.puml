@startuml "CUS-04: Administrar Conexiones"
left to right direction

skinparam usecase {
  BackgroundColor #FFF9C4
  BorderColor #7A1631
  StereotypeFontColor #2E7D32
}
skinparam actor {
  BackgroundColor #FFF9C4
  BorderColor #7A1631
  StereotypeFontColor #2E7D32
}
skinparam Arrow {
  Color #7A1631
}

actor "Usuario" as Cliente
actor "Base de Datos Externa" <<Sistema Externo>> as BDExt

rectangle "Gestión de Datos y Metadatos" {
  usecase "Subir archivo CSV/Excel" as UC1
  usecase "Conectar Base de Datos SQL" as UC2
  usecase "Extraer Esquema de Tablas" as UC3
  usecase "Definir Metadatos de Columnas" as UC4
}

Cliente -- UC1
Cliente -- UC2
Cliente -- UC4

UC1 .> UC3 : <<include>>
UC2 .> UC3 : <<include>>

UC3 -- BDExt
@enduml
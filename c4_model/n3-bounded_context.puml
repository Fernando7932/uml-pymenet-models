@startuml "Components-Bounded Contexts"
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Core Backend & API Gateway - Diagrama de Bounded Contexts

' Contenedores externos
Container(spa, "Single Page Application", "React", "Portal Principal")
Container(ai_engine, "AI Analytics Agent", "Python - Google ADK", "Microservicio de IA")
ContainerDb(db, "Database", "PostgreSQL", "BD interna del SaaS")
System_Ext(client_db, "Base de Datos Corporativa", "Sistemas del cliente")

' Límite del Contenedor Backend
Container_Boundary(api, "Core Backend & API Gateway") {
    Component(iam, "IAM Context", "Identity & Access", "Gestión de usuarios, roles y autenticación JWT")
    Component(workspaces, "Workspace Management Context", "Core Business", "Gestión de entornos, ingesta de archivos y extracción de esquemas SQL")
    Component(analytics, "Conversational Analytics Context", "Core Business", "Orquestación de sesiones de chat y almacenamiento de historial")
    Component(integration, "Agent Integration Context", "Proxy / Anti-Corruption", "Empaquetado de JSON Payload y comunicación segura con IA")
}

' Relaciones desde el exterior
Rel(spa, iam, "Autentica mediante [JSON/HTTPS]")
Rel(spa, workspaces, "Configura datos mediante [JSON/HTTPS]")
Rel(spa, analytics, "Interactúa en chat mediante [JSON/HTTPS]")

' Relaciones internas
Rel(workspaces, iam, "Verifica permisos")
Rel(analytics, iam, "Verifica permisos")
Rel(analytics, integration, "Delega prompt de usuario a")

' Relaciones hacia el exterior
Rel(integration, ai_engine, "Envía JSON Payload a [REST]")
Rel(workspaces, client_db, "Extrae diccionario de datos de [SQL/TCP]")
Rel(iam, db, "Lee y escribe perfiles en")
Rel(workspaces, db, "Lee y escribe metadatos en")
Rel(analytics, db, "Lee y escribe historial en")

@enduml